+def run_accessgraph(entry, options):
+    """AccessGraph single-page mode (W4A 2027 evaluation; local addition, not part of InterA11y)."""
+    home=Path(os.environ['ACCESSGRAPH_HOME'])
+    python=os.environ.get('ACCESSGRAPH_PYTHON',str(home/'.venv/bin/python'))
+    condition=options.get('condition') or 'run-1'
+    page=re.sub(r'[^A-Za-z0-9]+','-',str(entry.get('page') or entry['url'])).strip('-').lower()[-120:]
+    page=page+'-'+hashlib.sha1(str(entry.get('page') or entry['url']).encode()).hexdigest()[:8]
+    request={'url':entry['url'],'intera11y_sc':entry['sc'],'case_id':entry['case_id'],
+        'out_dir':str(home/'runs/w4a-d2/pages'/page),'stage':os.environ.get('ACCESSGRAPH_STAGE','external'),
+        'run_idx':int(condition.rsplit('-',1)[-1]) if condition.startswith('run-') else 1,
+        'target_xpath':entry.get('xpath') if entry.get('scope')=='element' else None}
+    output=Path(options['output_dir']);output.mkdir(parents=True,exist_ok=True)
+    with tempfile.TemporaryDirectory(prefix='accessgraph-') as temporary:
+        source=Path(temporary)/'request.json';target=Path(temporary)/'result.json'
+        source.write_text(json.dumps(request))
+        process=subprocess.run([python,'-m','eval.adapters.ag_single',str(source),str(target)],cwd=home,
+            stdout=subprocess.PIPE,stderr=subprocess.PIPE,text=True)
+        (output/'accessgraph.log').write_text(process.stdout+process.stderr)
+        if not target.exists():raise RuntimeError(process.stderr[-4000:] or 'AccessGraph returned no result')
+        reply=json.loads(target.read_text())
+    if reply.get('state')=='error':raise RuntimeError(reply.get('error') or 'AccessGraph error')
+    usage={'calls':reply['calls'],'paidCalls':reply['paid_calls'],'apiCostUsd':reply['cost_usd'],
+        'reportedApiCostUsd':reply['cost_usd'],'costSource':'accessgraph-cost-ledger'}
+    rows=[{'sc':r['sc'],'xpath':r['xpath'],'ruleId':r['type'],'outcome':r['outcome'],'reason':r['reason'],
+        'confidence':r.get('confidence')} for r in reply['rows']]
+    return normalized(entry,rows,usage=usage,timing={'seconds':reply.get('seconds')},raw=reply)
+
+
 def main(request):
     tool,entry,options=request['tool'],request['case'],request['options']
     os.environ['A11Y_HTTP_MAX_ATTEMPTS']='1'
     os.environ['A11Y_ANSWER_MAX_ATTEMPTS']='1'
     if tool in ['gena11y','ia-rubrics']:return run_gena11y(entry,options,rubrics=tool=='ia-rubrics')
     if tool=='accessguru':return run_accessguru(entry,options)
+    if tool=='accessgraph':return run_accessgraph(entry,options)
     if tool=='lopez-pereira':return run_lopez(entry,options)
     if tool in ['browser-use','agentlab']:return run_agents(tool,entry,options)
     if tool in ['bagel','lynx']:return run_research(tool,entry,options)
