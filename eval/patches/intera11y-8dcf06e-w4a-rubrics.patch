+++ b/runtime/intera11y/src/criteria/2.4.2.js
@@ -0,0 +1,31 @@
+'use strict';
+// W4A addition (InterA11y+): 2.4.2 Page Titled, in InterA11y's criterion format. Not part of InterA11y.
+const { PAGE } = require('./common.js');
+const { toolsOf } = require('../judge/rubric.js');
+const { headingsOf } = require('./descriptive-common.js');
+
+module.exports = {
+  sc: '2.4.2', title: 'Page Titled',
+  probes: ['content'],
+  tools: toolsOf('2.4.2'),
+
+  screen: { select: () => false, scope: 'page' },
+
+  identify() { return [{ xpath: PAGE, kind: 'page-title' }]; },
+
+  assess(c, obs, model) {
+    if (!String(model.doc.title || '').trim()) return { status: 'FAIL', rule: 'no-title', reason: 'The page has no title, or its title is empty, so it has nothing that describes its topic or purpose (ACT 2779a5).' };
+    return { status: 'OPEN', rule: 'title-to-judge' };
+  },
+
+  evidence(c, obs, model) {
+    return {
+      facts: {
+        title: model.doc.title,
+        documentLanguage: model.doc.lang || undefined,
+        headings: headingsOf(model).slice(0, 15).map((h) => ({ level: h.level, text: h.name.slice(0, 120) })),
+        visibleTextExcerpt: String(model.doc.text || '').slice(0, 2000),
+      },
+    };
+  },
+};
diff --git a/runtime/intera11y/src/criteria/2.4.6.js b/runtime/intera11y/src/criteria/2.4.6.js
new file mode 100644
index 0000000..fbb37dc
--- /dev/null
+++ b/runtime/intera11y/src/criteria/2.4.6.js
@@ -0,0 +1,53 @@
+'use strict';
+// W4A addition (InterA11y+): 2.4.6 Headings and Labels for headings, form field labels and button names, in
+// InterA11y's criterion format. Landmark and widget names are not covered. Not part of InterA11y.
+const { toolsOf } = require('../judge/rubric.js');
+const { exposed, roleOf, nameOf, attr, headingsOf, sectionOf, surroundings } = require('./descriptive-common.js');
+
+const FIELD_ROLE = /^(textbox|searchbox|combobox|listbox|spinbutton|slider|checkbox|radio|switch)$/;
+const BUTTON_INPUT = /^(button|submit|reset|image)$/i;
+
+function kindOf(e) {
+  const role = roleOf(e);
+  if (role === 'heading') return 'heading';
+  if (role === 'button' || (e.tag === 'input' && BUTTON_INPUT.test(attr(e, 'type') || ''))) return 'button-name';
+  if (FIELD_ROLE.test(role) || /^(select|textarea)$/.test(e.tag) || (e.tag === 'input' && !/^(hidden)$/i.test(attr(e, 'type') || ''))) return 'form-label';
+  return null;
+}
+
+module.exports = {
+  sc: '2.4.6', title: 'Headings and Labels',
+  probes: ['content'],
+  tools: toolsOf('2.4.6'),
+
+  screen: { select: (e) => !!kindOf(e) },
+
+  identify(model) {
+    const out = headingsOf(model).map((h) => ({ xpath: h.xpath, kind: 'heading', h, el: h.el }));
+    for (const e of model.elements) {
+      const kind = kindOf(e);
+      if (kind && kind !== 'heading' && exposed(e) && !e.disabled) out.push({ xpath: e.xpath, kind, el: e });
+    }
+    return out;
+  },
+
+  assess(c) {
+    if (!nameOf(c.el) && !(c.kind === 'heading' && c.h.name)) {
+      return { status: 'NOT_APPLICABLE', rule: 'no-name', reason: 'It has no accessible name. 2.4.6 asks that headings and labels that are present describe their topic or purpose; a missing name is a matter for other criteria (1.3.1, 4.1.2).' };
+    }
+    return { status: 'OPEN', rule: `${c.kind}-to-judge` };
+  },
+
+  evidence(c, obs, model) {
+    const e = c.el, ax = e.ax || {};
+    if (c.kind === 'heading') {
+      const section = sectionOf(model, obs.content, c.h);
+      return { element: e, facts: { headingLevel: c.h.level, accessibleName: ax.name, visibleText: e.text, contentUnderTheHeading: section.text, nextHeadingOfSameOrHigherLevel: section.nextHeading } };
+    }
+    const around = surroundings(model, obs.content, e);
+    if (c.kind === 'form-label') {
+      return { element: e, facts: { computedRole: ax.role, accessibleName: ax.name, nameFrom: ax.nameFrom, inputType: attr(e, 'type') || e.tag, autocomplete: ax.autocomplete || attr(e, 'autocomplete') || undefined, placeholder: attr(e, 'placeholder') || undefined, fieldName: attr(e, 'name') || undefined, required: ax.required || undefined, ...around } };
+    }
+    return { element: e, facts: { computedRole: ax.role, accessibleName: ax.name, nameFrom: ax.nameFrom, visibleText: e.text, type: attr(e, 'type') || undefined, controls: attr(e, 'aria-controls') || undefined, expanded: ax.expanded, pressed: ax.pressed, ...around } };
+  },
+};
diff --git a/runtime/intera11y/src/criteria/descriptive-common.js b/runtime/intera11y/src/criteria/descriptive-common.js
new file mode 100644
index 0000000..875e4f2
--- /dev/null
+++ b/runtime/intera11y/src/criteria/descriptive-common.js
@@ -0,0 +1,59 @@
+'use strict';
+// Shared by the W4A additions 2.4.2 and 2.4.6 (InterA11y+; a local addition, not part of InterA11y).
+const { key } = require('../lib/xpath.js');
+
+const exposed = (e) => e && e.rendered && !e.inert && !e.ariaHiddenSelf && !e.ariaHiddenAncestor && !(e.ax && e.ax.ignored);
+const roleOf = (e) => String((e.ax && e.ax.role) || e.role || '').toLowerCase();
+const nameOf = (e) => String((e.ax && e.ax.name) || '').trim();
+const attr = (e, name) => { const m = new RegExp(`\\s${name}\\s*=\\s*("([^"]*)"|'([^']*)'|([^\\s>]+))`, 'i').exec(e.openTag || ''); return m ? (m[2] ?? m[3] ?? m[4]) : null; };
+
+/** Document order of the page model's elements, by normalised XPath. */
+function orderOf(model) {
+  if (!model.__w4aOrder) model.__w4aOrder = new Map(model.elements.map((e, i) => [key(e.xpath), i]));
+  return model.__w4aOrder;
+}
+
+function headingsOf(model) {
+  return model.elements.filter((e) => exposed(e) && roleOf(e) === 'heading').map((e) => ({
+    xpath: e.xpath, el: e, name: nameOf(e) || String(e.text || '').trim(),
+    level: Number((e.ax && e.ax.level) || (/^h([1-6])$/.exec(e.tag) || [])[1] || 2),
+  }));
+}
+
+/** Visible text runs in document order, each with the index of its element. */
+function textRuns(model, content) {
+  const order = orderOf(model);
+  return ((content && content.texts) || []).map((t) => ({ ...t, at: order.get(key(t.xpath)) }))
+    .filter((t) => t.at !== undefined).sort((a, b) => a.at - b.at);
+}
+
+/** The text a heading introduces: what follows it up to the next heading of the same or a higher level. */
+function sectionOf(model, content, heading, limit = 900) {
+  const order = orderOf(model);
+  const start = order.get(key(heading.xpath));
+  const next = headingsOf(model).map((h) => ({ ...h, at: order.get(key(h.xpath)) }))
+    .find((h) => h.at > start && h.level <= heading.level);
+  const end = next ? next.at : Infinity;
+  const inside = new Set(model.elements.filter((e) => key(e.xpath).startsWith(key(heading.xpath) + '/')).map((e) => order.get(key(e.xpath))));
+  let text = '';
+  for (const t of textRuns(model, content)) {
+    if (t.at <= start || inside.has(t.at)) continue;
+    if (t.at >= end || text.length > limit) break;
+    text += (text ? ' | ' : '') + t.text;
+  }
+  return { text: text.slice(0, limit), nextHeading: next ? { level: next.level, text: next.name.slice(0, 120) } : null };
+}
+
+/** The nearest heading before an element, and the text runs just before and after it. */
+function surroundings(model, content, el, around = 3) {
+  const order = orderOf(model);
+  const at = order.get(key(el.xpath));
+  const before = headingsOf(model).map((h) => ({ ...h, at: order.get(key(h.xpath)) })).filter((h) => h.at < at).pop();
+  const runs = textRuns(model, content);
+  const inside = (t) => key(t.xpath) === key(el.xpath) || key(t.xpath).startsWith(key(el.xpath) + '/');
+  const prev = runs.filter((t) => t.at < at && !inside(t)).slice(-around).map((t) => t.text);
+  const next = runs.filter((t) => t.at > at && !inside(t)).slice(0, around).map((t) => t.text);
+  return { precedingHeading: before ? { level: before.level, text: before.name.slice(0, 120) } : null, textBefore: prev, textAfter: next };
+}
+
+module.exports = { exposed, roleOf, nameOf, attr, headingsOf, sectionOf, surroundings };
