@@ -0,0 +1,28 @@
+'use strict';
+// W4A addition (InterA11y+), modelled on rubrics/2.4.4.js and 1.1.1.js; based on WCAG 2.2 Understanding 2.4.6,
+// technique G130 and G131 and ACT rules b49b2e and cc0f0a. Landmark and widget names are not covered. Not part of
+// InterA11y.
+module.exports = {
+  sc: '2.4.6', title: 'Headings and Labels',
+  preamble: 'Headings and labels that are present must describe their topic or purpose. 2.4.6 does not require headings or labels to exist, and does not require them to be long.',
+  rules: [
+    {
+      from: 'added',
+      text: 'Headings must describe the topic or purpose of the content they introduce.',
+      tools: ['capture_full_page'],
+      rubric: `A heading fails when its accessible name does not describe the topic or purpose of the content it introduces, that is the content after it up to the next heading of the same or a higher level (ACT b49b2e; G130): a heading that names a different topic, step or item than that content, or a generic text ("Section", "Heading", "Content") where the content has its own topic. A heading passes when it identifies that topic, even briefly. Evidence: the heading's level and name, and the content under it.`,
+    },
+    {
+      from: 'added',
+      text: 'Labels of form fields must describe the purpose of the field.',
+      tools: ['query_ax_node'],
+      rubric: `A form field's label fails when it does not describe what the field is for (ACT cc0f0a; G131): it names other information than the field collects, as its input type, autocomplete purpose, format, placeholder or the surrounding form and group show, or it is generic ("Field 1", "Input") where the purpose is specific. A label passes when it identifies the information asked for, even briefly. Evidence: the computed name and its source, the input type, autocomplete, placeholder, the nearest heading and the text around the field.`,
+    },
+    {
+      from: 'added',
+      text: 'Button names must describe what the button does.',
+      tools: ['interact_and_observe', 'observe_state_after_activation'],
+      rubric: `A button's label fails when it does not describe the button's purpose (G131): it names a different action or object than the button acts on in its context, or it is generic ("Click", "Button", "Go") where the context does not make the action clear. A button passes when its name, read in its context (its form, group or the nearest heading), identifies its action. Evidence: the computed name and its source, the visible text, the element it controls and its state, the nearest heading and the text around it; interact_and_observe and observe_state_after_activation show what activating it does.`,
+    },
+  ],
+};
diff --git a/runtime/intera11y/src/criteria/2.4.2.js b/runtime/intera11y/src/criteria/2.4.2.js
