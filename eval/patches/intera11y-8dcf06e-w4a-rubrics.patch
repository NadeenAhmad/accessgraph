+'use strict';
+// W4A addition (InterA11y+), modelled on rubrics/2.4.4.js and 1.1.1.js; based on WCAG 2.2 Understanding 2.4.2,
+// technique G88, failure F25 and ACT rules 2779a5 and c4a8a4. Not part of InterA11y.
+module.exports = {
+  sc: '2.4.2', title: 'Page Titled',
+  preamble: 'A web page passes if it has a title that describes its topic or purpose.',
+  rules: [
+    {
+      from: 'added',
+      text: 'The page must have a non-empty title.',
+      tools: [],
+      rubric: `A page whose title element is missing, or whose title is empty or only white space, fails (ACT 2779a5). Evidence: the document title.`,
+    },
+    {
+      from: 'added',
+      text: 'The page title must describe the topic or purpose of the page.',
+      tools: ['capture_full_page'],
+      rubric: `A title fails when it does not identify the topic or purpose of the page as the page presents it (ACT c4a8a4; F25): a title that names a different page, step, item or topic than the content shows, or a placeholder or generic title ("Untitled", "Page", "New document") on a page with its own topic. A title passes when it identifies what the page is about, even when it is short or also names the site (G88). Judge the title against the page's main heading and its content; do not require it to repeat the heading. Evidence: the title, the page's headings and its visible text.`,
+    },
+  ],
+};
diff --git a/runtime/intera11y/rubrics/2.4.6.js b/runtime/intera11y/rubrics/2.4.6.js
